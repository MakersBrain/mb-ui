# Consumers of @makersbrain/brand need this in their own .npmrc.
#
# The package is published to GitHub Packages, not npmjs.com, so the scope has
# to be pointed at that registry explicitly -- npm has no way to discover it.
# The token needs only `read:packages`.
@makersbrain:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
